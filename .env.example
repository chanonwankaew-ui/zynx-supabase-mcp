# Runtime profile. Use development locally, then staging/production with separate Supabase keys.
ZYNX_ENV=development

# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Use a server-side key only. For production, prefer a restricted service key or RPC with RLS.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SERVER_KEY

# Comma-separated table allowlist. The MCP server refuses all other tables.
ZYNX_ALLOWED_TABLES=zynx_projects,zynx_project_tasks,zynx_memory,zynx_audit_logs,zynx_documents,zynx_vectors,zynx_tool_runs

# Default/max query limits
ZYNX_DEFAULT_LIMIT=10
ZYNX_MAX_LIMIT=100

# Optional: write audit events into this table if it exists.
ZYNX_AUDIT_TABLE=zynx_audit_logs
ZYNX_ENABLE_AUDIT=true

# Local filesystem access for coding/automation tools. Keep this narrow.
ZYNX_WORKSPACE_ROOTS=/Users/kant/zynx-supabase-mcp
ZYNX_MAX_FILE_BYTES=200000
