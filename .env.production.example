ZYNX_ENV=production
SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_PRODUCTION_RESTRICTED_SERVER_KEY
ZYNX_ALLOWED_TABLES=zynx_projects,zynx_project_tasks,zynx_memory,zynx_audit_logs,zynx_documents,zynx_vectors,zynx_tool_runs
ZYNX_DEFAULT_LIMIT=10
ZYNX_MAX_LIMIT=50
ZYNX_AUDIT_TABLE=zynx_audit_logs
ZYNX_ENABLE_AUDIT=true
ZYNX_WORKSPACE_ROOTS=/srv/zynx/workspaces
ZYNX_MAX_FILE_BYTES=100000
